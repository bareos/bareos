set -e
set -o pipefail
set -u

TestName="$(basename "$(pwd)")"
export TestName

# shellcheck source=../../environment.in
. ./environment

# shellcheck source=../../scripts/functions
. "${BAREOS_SCRIPTS_DIR}"/functions

# Make sure that the storage daemon does _not_ try to use a same volume to
# write & read the virtualfull.

start_test

run_bconsole - <<END_OF_DATA
@$out ${NULL_DEV}
messages
@$out ${tmp}/job-full.out
run job=backup-bareos-fd level=Full yes
@$out ${tmp}/job-vf-1.out
run job=backup-bareos-fd level=VirtualFull yes
@$out ${tmp}/job-vf-2.out
run job=backup-bareos-fd level=VirtualFull yes
END_OF_DATA

# This job may hang if it tries to read & write to the same volume
LAST_JOB=$(last_jobid_or_zero)

run_bconsole - <<END_OF_DATA
@$out ${tmp}/msgs.out
wait timeout=30 jobid=${LAST_JOB}
messages
END_OF_DATA

check_log "${tmp}/msgs.out"
expect_grep "Termination:.*OK" \
  "${tmp}/msgs.out" \
  "No job was successful"

end_test
