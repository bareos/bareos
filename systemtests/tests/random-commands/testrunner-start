set -e
set -o pipefail
set -u

TestName="$(basename "$(pwd)")"
export TestName

#shellcheck source=../../environment.in
. ./environment

#shellcheck source=../../scripts/functions
. "${BAREOS_SCRIPTS_DIR}"/functions
#shellcheck source=functions
. functions

start_test

setup_data

cat <<END_OF_DATA >"$tmp/bconcmds"
@$out ${NULL_DEV}
messages
@$out $log_home/setup.out
status director
status client
status storage=File


label volume=Full-0001 pool=Full
label volume=Full-0002 pool=Full
label volume=Full-0003 pool=Full
label volume=Incremental-0001 pool=Incremental
label volume=Incremental-0002 pool=Incremental
label volume=Incremental-0003 pool=Incremental
label volume=Differential-0001 pool=Differential
label volume=Differential-0002 pool=Differential
label volume=Differential-0003 pool=Differential

@$out $log_home/full.out
run job=backup-bareos-fd level=Full yes
wait
messages
@$out $log_home/diff.out
run job=backup-bareos-fd level=Differential yes
wait
messages
@$out $log_home/incr.out
run job=backup-bareos-fd level=Incremental yes
wait
messages
END_OF_DATA

run_bconsole

expect_grep "Backup OK" "$log_home/full.out" "full was not successful"
expect_grep "Backup OK" "$log_home/diff.out" "diff was not successful"
expect_grep "Backup OK" "$log_home/incr.out" "incr was not successful"

# Statistics select jobs strictly older than the current whole second.
sleep 1
cat <<END_OF_DATA >"$tmp/bconcmds"
@$out $log_home/update-stats.out
update stats
update stats
.api 2
@$out $log_home/history.json
.sql query="SELECT count(*) AS jobs FROM JobHisto WHERE Name='backup-bareos-fd'"
END_OF_DATA
run_bconsole

expect_grep "Updating 3 job(s)." "$log_home/update-stats.out" \
  "Completed backups were not copied to JobHisto"
expect_grep "Updating 0 job(s)." "$log_home/update-stats.out" \
  "Updating statistics duplicated history rows"
expect_grep '"jobs": "3"' "$log_home/history.json" \
  "JobHisto does not contain all three completed backups"

end_test
