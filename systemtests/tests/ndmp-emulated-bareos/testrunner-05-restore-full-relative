set -e
set -o pipefail
set -u

#
# make sure we can restore a full backup to some relative location
#

TestName="$(basename "$(pwd)")"
export TestName

#shellcheck source=../../environment.in
. ./environment

#shellcheck source=../../scripts/functions
. "${BAREOS_SCRIPTS_DIR}"/functions
start_test

# remove files
rm -rf "${NDMP_FILESYSTEM}"

restore_path="bareos-restores"

cat <<END_OF_DATA >"${tmp}/bconcmds"
@$out ${log_home}/restore.out
restore jobid=1 client=${NDMPCLIENT} fileset=ndmp-fileset restorejob=NDMPRestoreDump where=/${restore_path} all done yes
wait
messages
END_OF_DATA

run_bconsole "${tmp}/bconcmds"

check_log "${log_home}/restore.out"
expect_grep "Termination:.*Restore OK" "${log_home}/restore.out" \
  "restore did not succeed"

# a relative location is relative to the NDMP filesystem
check_ndmp_data_full "${NDMP_FILESYSTEM}/${restore_path}"

check_for_zombie_jobs storage=ndmpfile client=bareos-fd

end_test
