FileSet {
  Name = "PluginOptionsTest-tasks-mysql"
  Description = "Smoke-test fileset backed by the bpipe plugin (Tasks MySQL-style demo data)"
  Enable VSS = No
  Include {
    Options {
      Signature = XXH128
    }
    Plugin = "bpipe"
             ":file=/tasks-mysql-demo/dump.sql"
             ":reader=bash @current_test_directory@/readprogram"
             ":writer=bash @current_test_directory@/writeprogram"
  }
}
