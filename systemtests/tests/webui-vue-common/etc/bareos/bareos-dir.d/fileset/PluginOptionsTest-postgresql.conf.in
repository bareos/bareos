FileSet {
  Name = "PluginOptionsTest-postgresql"
  Description = "Smoke-test fileset backed by the bpipe plugin with PostgreSQL options"
  Enable VSS = No
  Include {
    Options {
      Signature = XXH128
    }
    Plugin = "bpipe"
             ":file=/postgresql-demo/dump.sql"
             ":reader=bash @current_test_directory@/readprogram"
             ":writer=bash @current_test_directory@/writeprogram"
             ":module_name=bareos-fd-postgresql"
             ":dbuser=postgres"
             ":dbname=appdb"
             ":switch_wal=yes"
  }
}
