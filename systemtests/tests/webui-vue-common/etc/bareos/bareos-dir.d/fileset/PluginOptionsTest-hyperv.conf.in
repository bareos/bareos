FileSet {
  Name = "PluginOptionsTest-hyperv"
  Description = "Smoke-test fileset backed by the bpipe plugin (Hyper-V-style demo data)"
  Enable VSS = No
  Include {
    Options {
      Signature = XXH128
    }
    Plugin = "bpipe"
             ":file=/hyperv-demo/vm.vhdx"
             ":reader=bash @current_test_directory@/readprogram"
             ":writer=bash @current_test_directory@/writeprogram"
  }
}
