FileSet {
  Name = "PluginOptionsTest-tasks-oracle"
  Description = "Smoke-test fileset backed by the bpipe plugin (Tasks Oracle-style demo data)"
  Enable VSS = No
  Include {
    Options {
      Signature = XXH128
    }
    Plugin = "bpipe"
             ":file=/tasks-oracle-demo/dump.dmp"
             ":reader=bash @current_test_directory@/readprogram"
             ":writer=bash @current_test_directory@/writeprogram"
  }
}
