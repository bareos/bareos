FileSet {
  Name = "PluginOptionsTest-vmware"
  Description = "Smoke-test fileset backed by the bpipe plugin with VMware options"
  Enable VSS = No
  Include {
    Options {
      Signature = XXH128
    }
    Plugin = "bpipe"
             ":file=/vmware-demo/vmware-backup.vmdk"
             ":reader=bash @current_test_directory@/readprogram"
             ":writer=bash @current_test_directory@/writeprogram"
             ":module_name=bareos-fd-vmware"
             ":vcserver=vcenter.example.com"
             ":vcuser=admin"
             ":vcpass=secret"
             ":dc=Datacenter1"
             ":folder=/vms"
             ":vmname=TestVM"
  }
}
