FileSet {
  Name = "PluginOptionsTest-proxmox"
  Description = "Smoke-test fileset backed by the bpipe plugin with Proxmox options"
  Enable VSS = No
  Include {
    Options {
      Signature = XXH128
    }
    Plugin = "bpipe"
             ":file=/proxmox-demo/100.vma"
             ":reader=bash @current_test_directory@/readprogram"
             ":writer=bash @current_test_directory@/writeprogram"
             ":module_name=bareos-fd-proxmox"
             ":vmid=100"
             ":storage=local-lvm"
             ":mode=snapshot"
  }
}
