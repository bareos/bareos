FileSet {
  Name = "PluginOptionsTest-percona-xtrabackup"
  Description = "Smoke-test fileset backed by the bpipe plugin with Percona XtraBackup options"
  Enable VSS = No
  Include {
    Options {
      Signature = XXH128
    }
    Plugin = "bpipe"
             ":file=/percona-xtrabackup-demo/stream"
             ":reader=bash @current_test_directory@/readprogram"
             ":writer=bash @current_test_directory@/writeprogram"
             ":module_name=bareos-fd-percona-xtrabackup"
             ":user=root"
             ":password=secret"
  }
}
