FileSet {
  Name = "PluginOptionsTest-qumulo"
  Description = "Smoke-test fileset backed by the bpipe plugin (Qumulo-style demo data)"
  Enable VSS = No
  Include {
    Options {
      Signature = XXH128
    }
    Plugin = "bpipe"
             ":file=/qumulo-demo/snapshot.qfsd"
             ":reader=bash @current_test_directory@/readprogram"
             ":writer=bash @current_test_directory@/writeprogram"
  }
}
