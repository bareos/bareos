FileSet {
  Name = "PluginOptionsTest-libcloud"
  Description = "Smoke-test fileset backed by the bpipe plugin (Libcloud-style demo data)"
  Enable VSS = No
  Include {
    Options {
      Signature = XXH128
    }
    Plugin = "bpipe"
             ":file=/libcloud-demo/objects.tar"
             ":reader=bash @current_test_directory@/readprogram"
             ":writer=bash @current_test_directory@/writeprogram"
  }
}
