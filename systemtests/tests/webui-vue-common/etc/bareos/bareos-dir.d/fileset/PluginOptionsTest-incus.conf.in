FileSet {
  Name = "PluginOptionsTest-incus"
  Description = "Smoke-test fileset backed by the bpipe plugin (Incus-style demo data)"
  Enable VSS = No
  Include {
    Options {
      Signature = XXH128
    }
    Plugin = "bpipe"
             ":file=/incus-demo/instance.tar"
             ":reader=bash @current_test_directory@/readprogram"
             ":writer=bash @current_test_directory@/writeprogram"
  }
}
