FileSet {
  Name = "fileset-multi-includes"
  Include {
     Options {
        Signature = XXH128
     }
     File=@tmpdir@/data-multi-includes/data1
  }
  Include {
     Options {
        Signature = XXH128
        Compression = GZIP
     }
     File=@tmpdir@/data-multi-includes/data2
  }
  Include {
     Options {
        Signature = XXH128
        Compression = GZIP9
     }
     File=@tmpdir@/data-multi-includes/data3
  }
  Include {
     Options {
        Signature = XXH128
        Compression = LZ4
     }
     File=@tmpdir@/data-multi-includes/data4
  }
@ZSTD_COMMENT@  Include {
@ZSTD_COMMENT@     Options {
@ZSTD_COMMENT@        Signature = XXH128
@ZSTD_COMMENT@        Compression = ZSTD10
@ZSTD_COMMENT@     }
@ZSTD_COMMENT@     File=@tmpdir@/data-multi-includes/data5
@ZSTD_COMMENT@  }
@ZSTD_COMMENT@  Include {
@ZSTD_COMMENT@     Options {
@ZSTD_COMMENT@        Signature = XXH128
@ZSTD_COMMENT@        Compression = ZSTD1
@ZSTD_COMMENT@     }
@ZSTD_COMMENT@     File=@tmpdir@/data-multi-includes/data6
@ZSTD_COMMENT@  }
}
