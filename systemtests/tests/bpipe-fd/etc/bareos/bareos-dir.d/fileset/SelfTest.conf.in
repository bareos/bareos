FileSet {
  Name = "SelfTest"
  Enable VSS = No

  Include {
    Options {
      Signature = XXH128
    }
    Plugin = "bpipe"
             ":file=/bpipe"
             ":reader=bash ./readprogram-accounting"
             ":writer=bash ./writeprogram"
  }
}

FileSet {
  Name = BscanBootstrap
  Enable VSS = No

  Include {
    Options {
      Signature = XXH128
    }
    Plugin = "bpipe:file=/bscan-first"
             ":reader=bash ./readprogram-accounting:writer=bash ./writeprogram"
    Plugin = "bpipe:file=/bscan-second"
             ":reader=bash ./readprogram-accounting:writer=bash ./writeprogram"
  }
}

FileSet {
  Name = bpipe-unique
  Enable VSS = No

  Include {
    Options {
       Signature = XXH128
    }

    Plugin = "bpipe"
             ":file=/bpipe"
             ":reader=bash ./readprogram"
             ":writer=bash ./writeprogram"
             ":usesuffix=true"
  }
}
