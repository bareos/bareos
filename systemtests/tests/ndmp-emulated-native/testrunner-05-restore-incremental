set -e
set -o pipefail
set -u

#
# make sure we can restore an incremental backup
#

TestName="$(basename "$(pwd)")"
export TestName

#shellcheck source=../../environment.in
. ./environment

#shellcheck source=../../scripts/functions
. "${BAREOS_SCRIPTS_DIR}"/functions
start_test

# remove files
rm -rf "${NDMP_FILESYSTEM}"

cat <<END_OF_DATA >"${tmp}/bconcmds"
@$out ${log_home}/restore.out
restore select jobid=2 client=${NDMPCLIENT} fileset=ndmp-fileset restorejob=NDMPRestoreDump
mark ${NDMP_FILESYSTEM}/incremental
done
yes
wait
messages
END_OF_DATA

run_bconsole "${tmp}/bconcmds"

check_native_restore_log "${log_home}/restore.out"
expect_grep "Termination:.*Restore OK" "${log_home}/restore.out" \
  "restore did not succeed"

# TODO: the restore expands jobid=2 to "1,2", but the NDMP_NATIVE restore
# only uses the first jobid (see GetNdmmediaInfoFromDatabase()), so the
# image of the full backup is restored instead of the incremental one and
# the incremental file is missing. Enable this check once that is fixed:
# [ "$(cat "${NDMP_FILESYSTEM}/incremental")" = "incremental-1" ] \
#   || set_error "wrong content of the restored incremental file"

check_no_running_jobs

end_test
