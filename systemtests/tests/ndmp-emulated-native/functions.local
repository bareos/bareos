#shellcheck source=../../scripts/functions-ndmjob
. "${BAREOS_SCRIPTS_DIR}"/functions-ndmjob

make_ndmp_data_full()
{
  mkdir -p "${NDMP_FILESYSTEM}/sub/dir"
  dd if=/dev/zero of="${NDMP_FILESYSTEM}/full" bs=1M count=20 2>/dev/null
  echo "end of full" >>"${NDMP_FILESYSTEM}/full"
  cp "${BAREOS_DIRECTOR_BINARY}" "${NDMP_FILESYSTEM}/testfile"
  # we need an additional file, so the restore doesn't pick the last file of
  # the volume and data stream
  cp "${BAREOS_STORAGEDAEMON_BINARY}" "${NDMP_FILESYSTEM}/testfile2"
  echo "file in a subdirectory" >"${NDMP_FILESYSTEM}/sub/dir/file"
  ln -s ../testfile "${NDMP_FILESYSTEM}/sub/link"
}

# copy of the data at the time of the full backup
export NDMP_REFERENCE="${tmp}/ndmp-reference"

save_ndmp_reference()
{
  rm -rf "${NDMP_REFERENCE}"
  cp -a "${NDMP_FILESYSTEM}" "${NDMP_REFERENCE}"
}

# compare the restored full backup in $1 with the reference
check_ndmp_data_full()
{
  # diff of FreeBSD 13 has no --no-dereference, check the symlink explicitly
  diff -r "${NDMP_REFERENCE}" "$1" \
    && [ "$(readlink "$1/sub/link")" = "../testfile" ]
}

# NDMP_NATIVE jobs only involve the director and ndmjob, so the generic
# check_for_zombie_jobs (which needs a storage daemon resource) does not
# apply. Make sure the director has no jobs left running instead.
check_no_running_jobs()
{
  cat <<END_OF_DATA >"${tmp}/bconcmds.status"
@output ${tmp}/dir-status.out
status director
END_OF_DATA
  run_bconsole "${tmp}/bconcmds.status"
  expect_grep "No Jobs running." "${tmp}/dir-status.out" \
    "jobs are still running in the director"
}
