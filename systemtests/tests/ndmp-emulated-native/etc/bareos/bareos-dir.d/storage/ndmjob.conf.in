Storage {
  Name = ndmjob
  Address = 127.0.0.1
  Port = @ndmjob_port@
  Protocol = NDMPv4
  Auth Type = MD5
  Username = "ndmp"
  Password = "ndmp"
  Maximum Concurrent Jobs = 1
  Autochanger = yes
  MediaType = NDMP-Tape

  Device = "@current_test_directory@/tmp/ndmjob/robot/drive0"  # tape file of the ndmjob robot simulator
  NDMP Changer Device = "@current_test_directory@/tmp/ndmjob/robot"  # directory of the ndmjob robot simulator
}
