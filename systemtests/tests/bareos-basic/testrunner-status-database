set -e
set -o pipefail
set -u

TestName="$(basename "$(pwd)")"
export TestName

#shellcheck source=../../environment.in
. ./environment

JobName=bconsole-status-database
#shellcheck source=../../scripts/functions
. "${BAREOS_SCRIPTS_DIR}"/functions

start_test

assert_contains()
{
  local file=$1
  local pattern=$2
  if ! grep -Eq "$pattern" "$file"; then
    set_error "Pattern '$pattern' not found in $file"
    estat=1
  fi
}

cat <<END_OF_DATA >"$tmp"/bconcmds
@$out $tmp/status-database-default.txt
status database
@$out ${NULL_DEV}
.api 2
@$out $tmp/status-database.json
status database
@$out ${NULL_DEV}
.api 0
END_OF_DATA

run_bconsole

assert_contains "$tmp/status-database-default.txt" "^Database Status:"
assert_contains "$tmp/status-database-default.txt" "^[[:space:]]+Status: (ok|warning|error|unavailable)$"
assert_contains "$tmp/status-database-default.txt" "^[[:space:]]+Checked at: "
assert_contains "$tmp/status-database-default.txt" "^[[:space:]]+Catalog: "
assert_contains "$tmp/status-database-default.txt" "^[[:space:]]+Engine: postgresql$"
assert_contains "$tmp/status-database-default.txt" "Largest tables:"

assert_contains "$tmp/status-database.json" "\"database_status\""
assert_contains "$tmp/status-database.json" "\"status\"[[:space:]]*:[[:space:]]*\"(ok|warning|error|unavailable)\""
assert_contains "$tmp/status-database.json" "\"checked_at\""
assert_contains "$tmp/status-database.json" "\"database\""
assert_contains "$tmp/status-database.json" "\"engine\"[[:space:]]*:[[:space:]]*\"postgresql\""
assert_contains "$tmp/status-database.json" "\"tables\""

end_test
