#
# Bareos WebUI Vue - Apache configuration file
#

Alias /bareos-webui-new @WEBUI_VUE_DIR@
Alias /favicon.ico @WEBUI_VUE_DIR@/favicon.ico

<Directory @WEBUI_VUE_DIR@>
    Options FollowSymLinks
    AllowOverride None
    Require all granted
</Directory>

# Proxy WebSocket connections to bareos-webui-proxy
ProxyPass /bareos-webui-new/ws ws://localhost:9104/ws
ProxyPassReverse /bareos-webui-new/ws ws://localhost:9104/ws
ProxyPass /bareos-webui-new/api/ http://localhost:9104/api/
ProxyPassReverse /bareos-webui-new/api/ http://localhost:9104/api/

<IfModule mod_headers.c>
    RequestHeader set X-Forwarded-Proto expr=%{REQUEST_SCHEME}
</IfModule>
