#
# Bareos WebUI Vue - Apache configuration file
#

Alias /bareos-webui-new @WEBUI_VUE_DIR@
Alias /favicon.ico @WEBUI_VUE_DIR@/favicon.ico

<Directory @WEBUI_VUE_DIR@>
    Options FollowSymLinks
    AllowOverride None
    Require all granted

    # SPA routing: redirect all non-file requests to index.html
    <IfModule mod_rewrite.c>
        RewriteEngine on
        RewriteBase /bareos-webui-new
        RewriteCond %{REQUEST_FILENAME} !-f
        RewriteCond %{REQUEST_FILENAME} !-d
        RewriteRule ^ index.html [L]
    </IfModule>

    # index.html references the current build's content-hashed asset
    # filenames, so it must always be revalidated: caching it would let a
    # browser/proxy keep serving a stale index.html after a redeploy,
    # pointing at asset filenames that no longer exist (404s).
    <IfModule mod_headers.c>
        <FilesMatch "^index\.html$">
            Header set Cache-Control "no-cache, must-revalidate"
        </FilesMatch>
    </IfModule>
</Directory>

# Every file under assets/ is content-hashed by the Vite build, so a given
# filename's content never changes -- safe to cache indefinitely, unlike
# index.html above.
<Directory @WEBUI_VUE_DIR@/assets>
    <IfModule mod_headers.c>
        Header set Cache-Control "public, max-age=31536000, immutable"
    </IfModule>
</Directory>

<Location /bareos-webui-new>
  ErrorDocument 404 /bareos-webui-new/404.html
</Location>

# Proxy WebSocket connections to bareos-webui-proxy
ProxyPass /bareos-webui-new/ws ws://localhost:9104/ws
ProxyPassReverse /bareos-webui-new/ws ws://localhost:9104/ws
ProxyPass /bareos-webui-new/api/ http://localhost:9104/api/
ProxyPassReverse /bareos-webui-new/api/ http://localhost:9104/api/

<IfModule mod_headers.c>
    RequestHeader set X-Forwarded-Proto expr=%{REQUEST_SCHEME}
</IfModule>
